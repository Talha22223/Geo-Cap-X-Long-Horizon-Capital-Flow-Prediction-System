# Service Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=false

# Database & Redis Connection Strings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/geocapx
REDIS_URL=redis://localhost:6379/1

# NLP Provider
NLP_PROVIDER=spacy
SPACY_MODEL=en_core_web_sm

# External API Keys (Placeholders)
NEWSAPI_KEY=your_newsapi_key_here
FRED_API_KEY=your_fred_api_key_here
CONGRESS_API_KEY=your_congress_api_key_here
TRADING_ECONOMICS_API_KEY=your_trading_economics_key_here
WORLD_BANK_API_KEY=your_world_bank_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
