# GeoCap-X Monorepo Root Environment Configuration

# Service Ports
PORT=3001
WEB_PORT=3000
AI_PORT=8000

# Node Environment (development | production)
NODE_ENV=development

# Core Database Connection String (PostgreSQL 15)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geocapx?schema=public

# Core Redis Connection String (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/1

# API Gateway Security & JWT
JWT_SECRET=your_jwt_secret_min_32_characters_here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Public API Endpoints
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_AI_URL=http://localhost:8000

# Stripe Payment Gateway (Test Mode / Production)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PRO_PRICE_ID=price_your_pro_price_id_here
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id_here

# External Data Engine API Keys (Optional - Fill in your own keys if connecting to live providers)
NEWSAPI_KEY=your_newsapi_key_here
FRED_API_KEY=your_fred_api_key_here
CONGRESS_API_KEY=your_congress_api_key_here
TRADING_ECONOMICS_API_KEY=your_trading_economics_key_here
WORLD_BANK_API_KEY=your_world_bank_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
